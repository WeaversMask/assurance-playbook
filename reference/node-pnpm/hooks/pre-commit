#!/usr/bin/env sh
# Argus pre-commit hook
#
# Staged-scope quality gates via lint-staged (ESLint check + Prettier
# auto-fix with re-stage), then a gitleaks secret scan of the staged
# changes. Gitleaks runs last so it scans what will actually be committed
# (post-Prettier content). CI keeps the full-repo lint/format jobs as the
# backstop.
#
# The quality gates can be skipped individually via the SKIP env var
# (comma-separated):
#   SKIP=lint git commit ...      (skips ESLint)
#   SKIP=format git commit ...    (skips Prettier)
#   SKIP=lint,format git commit ...
#
# Skipping either requires justification in the commit message.
#
# THE SECRET SCAN IS NOT SKIPPABLE. There is deliberately no SKIP=gitleaks
# (secret-scanning.md invariant 3). A per-commit escape hatch on the scan
# is indistinguishable from no scan on the commit that needed it most, and
# it doubles as a bypass of the missing-.gitleaks.local.toml check below —
# so one flag disarms both the secret layer and the identity layer at
# once. A secret-shaped string that must legitimately be committed gets an
# allowlist entry in .gitleaks.toml, reviewed like any other change, not a
# bypass that leaves no trace outside a commit message.

set -e

# Normalize SKIP so "lint, format" and "LINT" behave like "lint,format" —
# lint-staged.config.mjs applies the same normalization.
skip_normalized=$(printf '%s' "${SKIP:-}" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')

is_skipped() {
  case ",${skip_normalized}," in
    *",$1,"*) return 0 ;;
    *)        return 1 ;;
  esac
}

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Refuse the retired flag rather than ignoring it: a committer who types
# SKIP=gitleaks believes the scan was skipped, and silently scanning anyway
# would be the good outcome — but silently *proceeding* past a typo'd
# combination like SKIP=gitleaks,lint would not. Fail loudly instead.
case ",${skip_normalized}," in
  *",gitleaks,"*)
    echo "❌ pre-commit: SKIP=gitleaks is not supported — the secret scan cannot be skipped."
    echo "   If a secret-shaped string must legitimately be committed, add a"
    echo "   scoped allowlist entry to .gitleaks.toml so the exception is"
    echo "   reviewable and permanent, instead of invisible in a commit message."
    echo "   See docs/SECURITY-NOTES.md."
    exit 1
    ;;
esac

# --- Node floor guard --------------------------------------------------------
# Hooks inherit the invoking shell's Node. Below the engines.node floor,
# pnpm 11 (lint-staged here, commitlint in commit-msg) dies with a cryptic
# ERR_UNKNOWN_BUILTIN_MODULE (node:sqlite) — fail fast with instructions
# instead. Floor is read from package.json engines.node (single source of
# truth), enforced at major.minor granularity; the floor parse falls back
# to 22.22 if engines is unreadable, and an unparseable `node -v` fails
# CLOSED (an unevaluable check must block, not slip through — review
# finding on #15). Deliberately not SKIP-able: skipping wouldn't rescue
# the commit, pnpm below the floor crashes regardless.
node_floor="$(node -p "require('./package.json').engines.node.replace(/[^0-9.]/g, '')" 2>/dev/null || true)"
node_have="$(node -v 2>/dev/null | sed 's/^v//' || true)"
floor_major="${node_floor%%.*}"
floor_rest="${node_floor#*.}"
floor_minor="${floor_rest%%.*}"
have_major="${node_have%%.*}"
have_rest="${node_have#*.}"
have_minor="${have_rest%%.*}"

is_uint() {
  case "$1" in
    '' | *[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

# Sanitize the floor (defaults, not blocking — a broken engines field is a
# repo bug, not the committer's environment); validate the committer's
# version strictly.
is_uint "$floor_major" || floor_major=22
is_uint "$floor_minor" || floor_minor=22

node_ok=1
if ! is_uint "$have_major" || ! is_uint "$have_minor"; then
  node_ok=0 # missing node, or version output we can't evaluate → fail closed
elif [ "$have_major" -lt "$floor_major" ]; then
  node_ok=0
elif [ "$have_major" -eq "$floor_major" ] && [ "$have_minor" -lt "$floor_minor" ]; then
  node_ok=0
fi
if [ "$node_ok" -eq 0 ]; then
  echo "❌ pre-commit: Node ${node_have:-<not found>} is below the toolchain floor (>=${floor_major}.${floor_minor}, from package.json engines.node)."
  echo "   The hooks' pnpm would crash cryptically (ERR_UNKNOWN_BUILTIN_MODULE node:sqlite)."
  echo "   Fix: run 'nvm use' in this shell and retry — or add 'nvm use --silent' to"
  echo "   ~/.config/husky/init.sh so every hook picks up .nvmrc automatically."
  exit 1
fi

if is_skipped lint; then
  echo "⚠️  pre-commit: SKIP=lint — bypassing eslint on staged files"
fi
if is_skipped format; then
  echo "⚠️  pre-commit: SKIP=format — bypassing prettier on staged files"
fi

if is_skipped lint && is_skipped format; then
  : # both quality gates skipped — nothing for lint-staged to do
else
  # lint-staged.config.mjs reads SKIP and drops the corresponding task.
  pnpm exec lint-staged --config lint-staged.config.mjs
fi

# --- Secret scan (unconditional) ---------------------------------------------
gitleaks_bin=""
if [ -x "$repo_root/.bin/gitleaks" ]; then
  gitleaks_bin="$repo_root/.bin/gitleaks"
elif command -v gitleaks >/dev/null 2>&1; then
  gitleaks_bin="gitleaks"
else
  echo "❌ pre-commit: gitleaks not found."
  echo "   Run: ./scripts/install-gitleaks.sh"
  echo "   Or install system-wide (brew install gitleaks) and retry."
  echo "   There is no bypass — the secret scan must run on every commit."
  exit 1
fi

# --- Personal-identifier layer (identity-protection.md invariants 3 & 5) --
# The per-machine `.gitleaks.local.toml` holds the patterns that would
# disclose what they guard if committed, so it cannot ship with the repo —
# which makes it a manual bootstrap step, which makes it forgettable. It
# was forgotten in Argus, and a real name sat in a tracked file for months
# with three scan layers running and no rule that could match it.
#
# So its ABSENCE is a hard failure here, not a warning. Checking that a
# file exists discloses nothing. The local config chains to the committed
# one via `[extend] path = ".gitleaks.toml"`, so this second pass also
# re-applies every repo allowlist.
#
# Projects with no pseudonymity requirement opt out by putting the marker
# `assurance:no-local-identity-rules` in a comment in .gitleaks.toml —
# explicit, visible in review, and fail-closed by default.
#
# The committed config is read here, so a missing .gitleaks.toml would make
# the grep error out and report the failure against the wrong file. Check
# it first and say which file is actually absent.
if [ ! -f "$repo_root/.gitleaks.toml" ]; then
  echo "❌ pre-commit: .gitleaks.toml is missing — the repo's committed scanner config."
  echo "   The secret scan cannot run without it. Restore it before committing."
  exit 1
fi
# The marker must be a STANDALONE COMMENT LINE. A bare substring search is
# disarmable by prose: any text in .gitleaks.toml that merely mentions the
# marker satisfies it, and the likeliest such text is a comment explaining
# that the project does NOT opt out. That disarmed this check in a live port
# (2026-08-15) — silently, which is the whole failure mode invariant 5a
# exists to prevent.
#
# TWO FAILURES, NOT ONE. A missing file and a copied-but-unedited file are the
# same failure wearing different clothes: no rule that could match. The second
# only became reachable once the block below started printing a fillable shape,
# so both are checked here.
#
# EVERY MESSAGE BELOW IS CONTENT-FREE — file names and line numbers only, never
# a line of .gitleaks.local.toml. The maintainer pastes this output into the
# verification matrix, and echoing a matching line would put the identifiers
# being protected into a committed file and an agent's context at once.
if grep -qE '^[[:space:]]*#[[:space:]]*assurance:no-local-identity-rules[[:space:]]*$' \
  "$repo_root/.gitleaks.toml"; then
  : # Non-pseudonymous project: opted out, deliberately and standalone.
elif [ ! -f "$repo_root/.gitleaks.local.toml" ]; then
  echo "❌ pre-commit: .gitleaks.local.toml is missing."
  echo "   Personal-identifier scanning is unarmed — the committed config"
  echo "   cannot carry your email or legal name without disclosing them."
  echo "   Write it by hand. NEVER let an agent create it or read its contents."
  echo
  echo "   ─── the shape it must have ───"
  echo "   [extend]"
  echo "   path = \".gitleaks.toml\""
  echo
  echo "   then one [[rules]] block per identifier, each with an id and a regex:"
  echo "     personal-email        your real address(es), regex-escaped"
  echo "     personal-email-domain any address at your personal domain"
  echo "     home-directory-path   /Users/<user>, /home/<user>, C:\\Users\\<user>"
  echo "     real-name             your legal name, if it must stay out of content"
  echo
  echo "   ─── then prove it fires, one probe per rule ───"
  echo "   Write one line per rule using your REAL values into a temp file and"
  echo "   confirm every rule id appears. Counting hits is not enough: the email"
  echo "   rules overlap, so four hits can come from two working rules and two"
  echo "   dead ones. The full command is in the example's footer."
  echo
  echo "   Example with placeholders: templates/gitleaks.local.example.toml"
  echo "   Project not pseudonymous? Put a standalone comment line containing"
  echo "   'assurance:no-local-identity-rules' in .gitleaks.toml."
  exit 1
elif grep -q 'ASSURANCE-PLACEHOLDER' "$repo_root/.gitleaks.local.toml"; then
  echo "❌ pre-commit: .gitleaks.local.toml still holds example placeholders."
  echo "   It was copied but not filled in, so the personal-identifier layer is"
  echo "   unarmed — the file exists and no rule in it can match anything."
  echo "   Placeholder markers remain on line(s):"
  grep -n 'ASSURANCE-PLACEHOLDER' "$repo_root/.gitleaks.local.toml" | cut -d: -f1 | tr '\n' ' '
  echo
  echo "   Replace every placeholder value with a real one and delete its marker,"
  echo "   then run the per-rule self-test in the example's footer."
  exit 1
fi

"$gitleaks_bin" protect --staged --redact --config "$repo_root/.gitleaks.toml" --no-banner
if [ -f "$repo_root/.gitleaks.local.toml" ]; then
  "$gitleaks_bin" protect --staged --redact --config "$repo_root/.gitleaks.local.toml" --no-banner
fi
