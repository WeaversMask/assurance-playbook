#!/usr/bin/env sh
# Argus pre-push hook
#
# Second-layer secret scan: gitleaks over every commit that is about to
# leave the machine. Pre-commit scans staged content, but plenty of commits
# never pass through it — history rewritten after the staged scan (rebase,
# amend), conflict resolutions written during a merge or rebase, cherry-
# picks, and anything authored in a clone where the hooks were not
# installed. This hook closes that gap by scanning the exact outgoing range
# per pushed ref, so nothing unscanned lands on the remote.
#
# THERE IS NO BYPASS. SKIP=gitleaks is deliberately not supported here or
# in pre-commit (secret-scanning.md invariant 3): this is the last layer
# that runs before content leaves the machine, and a secret is compromised
# the moment it is pushed. A string that must legitimately be pushed gets a
# reviewed allowlist entry in .gitleaks.toml, not an invisible bypass.
#
# stdin (from git): one line per ref being pushed —
#   <local-ref> <local-sha> <remote-ref> <remote-sha>

set -e

skip_normalized=$(printf '%s' "${SKIP:-}" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
case ",${skip_normalized}," in
  *",gitleaks,"*)
    echo "❌ pre-push: SKIP=gitleaks is not supported — the outgoing-range secret scan cannot be skipped."
    echo "   If a secret-shaped string must legitimately be pushed, add a scoped"
    echo "   allowlist entry to .gitleaks.toml so the exception is reviewable,"
    echo "   instead of invisible in a PR description. See docs/SECURITY-NOTES.md."
    exit 1
    ;;
esac

repo_root="$(git rev-parse --show-toplevel)"

gitleaks_bin=""
if [ -x "$repo_root/.bin/gitleaks" ]; then
  gitleaks_bin="$repo_root/.bin/gitleaks"
elif command -v gitleaks >/dev/null 2>&1; then
  gitleaks_bin="gitleaks"
else
  echo "❌ pre-push: gitleaks not found."
  echo "   Run: ./scripts/install-gitleaks.sh"
  echo "   Or install system-wide (brew install gitleaks) and retry."
  echo "   There is no bypass — the scan must run before anything leaves the machine."
  exit 1
fi

# The committed config is read by the check below and passed to every scan,
# so name it explicitly when it is the thing that is missing.
if [ ! -f "$repo_root/.gitleaks.toml" ]; then
  echo "❌ pre-push: .gitleaks.toml is missing — the repo's committed scanner config."
  echo "   The outgoing-range scan cannot run without it. Restore it before pushing."
  exit 1
fi

# Personal-identifier layer (identity-protection.md invariants 3 & 5). Same
# gate as pre-commit: the per-machine rules file cannot ship with the repo,
# so nothing but a check like this makes its absence visible. Fail closed;
# opt out with the `assurance:no-local-identity-rules` marker in
# .gitleaks.toml for projects that are not pseudonymous.
local_config="$repo_root/.gitleaks.local.toml"
if [ ! -f "$local_config" ] &&
  ! grep -q 'assurance:no-local-identity-rules' "$repo_root/.gitleaks.toml"; then
  echo "❌ pre-push: .gitleaks.local.toml is missing — personal-identifier scanning is unarmed."
  echo "   Create it by hand from templates/gitleaks.local.example.toml (never via an agent)."
  echo "   Not a pseudonymous project? Add 'assurance:no-local-identity-rules' to .gitleaks.toml."
  exit 1
fi

# Configs to scan each outgoing range against. The local file chains to the
# committed one via `[extend] path`, but both are run explicitly so a
# mis-chained local config cannot silently drop the repo's own rules.
configs="$repo_root/.gitleaks.toml"
[ -f "$local_config" ] && configs="$configs $local_config"

zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha _remote_ref remote_sha; do
  # Deleting a remote ref pushes no commits — nothing to scan.
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # New remote ref: scan every commit not already on a remote-tracking
    # ref (i.e. everything this push would publish for the first time).
    # Deliberately broader than origin/main..HEAD so pushes to a second
    # remote are covered too, at the cost of a bigger first scan — a
    # conscious breadth/cost tradeoff, do not narrow it (#14 review).
    range="$local_sha --not --remotes"
  elif ! git rev-parse --verify -q "${remote_sha}^{commit}" >/dev/null 2>&1; then
    # The remote-tracking SHA git handed us is stale, pruned, or from a
    # never-fetched remote. A range built on it makes gitleaks error out
    # internally while still exiting 0 (#14 review, major finding) — fall
    # back to the conservative new-ref range instead of trusting it.
    echo "⚠️  pre-push: remote SHA for $local_ref does not resolve locally — scanning all not-yet-remote commits instead."
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  # gitleaks exits 0 on internal/git errors while logging ERR + "no leaks
  # found" (verified on the pinned version; #14 review, major finding).
  # Capture the output and fail CLOSED on any ERR line, not just on the
  # exit code — a scan that never ran must block, not pass.
  for config in $configs; do
    scan_status=0
    scan_output=$("$gitleaks_bin" detect --redact --no-banner \
      --config "$config" \
      --source "$repo_root" \
      --log-opts "$range" 2>&1) || scan_status=$?
    printf '%s\n' "$scan_output"
    if [ "$scan_status" -ne 0 ]; then
      echo "❌ pre-push: gitleaks flagged potential secrets in the outgoing commits ($local_ref)."
      echo "   Config: $(basename "$config")"
      echo "   Nothing was pushed — git aborts every ref in this push together."
      echo "   Scrub the offending commits before retrying (docs/SECURITY-NOTES.md)."
      exit 1
    fi
    if printf '%s' "$scan_output" | grep -q "ERR"; then
      echo "❌ pre-push: gitleaks reported an internal error — the scan did not complete; failing closed."
      echo "   Config: $(basename "$config")"
      echo "   Nothing was pushed — git aborts every ref in this push together."
      echo "   There is no bypass: fix the underlying git/gitleaks problem and retry."
      echo "   A broken scanner blocks pushes by design — that is the gate working."
      exit 1
    fi
  done
done

exit 0
