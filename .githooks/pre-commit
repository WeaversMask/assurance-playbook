#!/usr/bin/env sh
# Pre-commit hook for the assurance playbook itself.
#
# It runs three things, and the order is correctness rather than preference:
#
#   1. The safety class, in `.githooks/safety-checks.sh` — the declared identity,
#      the maintainer's per-machine patterns file, and a scan of the staged
#      changes against both scanner configs. It runs FIRST because it is the
#      cheap one and the one whose failure matters most: a leak should be refused
#      before the test suites spend a minute agreeing the repo is tidy.
#   2. The skill-copy freshness check, `runners/claude/check-skill-sync.sh`. It
#      compares the canonical skill with the copy installed on THIS machine, so
#      it cannot be one of the checks anyone else runs.
#   3. The verification checks, in `scripts/run-checks.sh`, which anyone can run
#      without committing. That script carries the argument for why each earns
#      its place.
#
# ACTIVATION: `git config core.hooksPath .githooks`. Committing this file does not
# arm it — a hook in the tree that nobody configured is exactly the kind of
# decoration this playbook exists to prevent. Verify with:
#   git config core.hooksPath   # expect: .githooks
#
# It is repo-WIDE, not additive: setting it makes git ignore `.git/hooks/*`
# entirely. Harmless here (that directory holds only samples), but any hook
# installed there later stops running silently, so a second hook belongs in this
# directory rather than that one.
#
# The skill check runs on every commit rather than only on commits touching the
# skill, because the drift it catches is usually introduced by editing the
# INSTALLED copy — which leaves no trace in this repo's staged changes at all.

set -e

repo_root="$(git rev-parse --show-toplevel)"

sh "$repo_root/.githooks/safety-checks.sh"
sh "$repo_root/runners/claude/check-skill-sync.sh"
sh "$repo_root/scripts/run-checks.sh"
